<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./common/head', {title: title}); %>
</head>
<body>

<table class="table table-hover">
    <thead>
    <tr class="bg-dark">
        <th class="text-light" scope="col">#</th>
        <th class="text-light" scope="col">Case name</th>
        <th class="text-light" scope="col">Options</th>
        <th class="text-light" scope="col">Link</th>
    </tr>
    </thead>
    <tbody>
    <% groups.forEach((group, groupIndex) => { %>
    <tr class="font-weight-bold text-success">
        <th scope="row"><%= groupIndex + 1 %></th>
        <td colspan="3"><%= group.label %></td>
    </tr>
    <% group.testCases.forEach(testCase => { const entryPage = testCase.pages[0]; %>
    <tr>
        <td colspan="2"></td>
        <td><%= testCase.label %></td>
        <td>
            <a href="<%= entryPage.path %>"><%= entryPage.path %></a>
        </td>
    </tr>
    <% }); %>
    <% }); %>
    </tbody>
</table>
</body>
</html>
